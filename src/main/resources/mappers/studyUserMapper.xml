<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- <mapper namespace="user2NS"> -->
<mapper namespace="com.spring.greenStudyS.dao.StudyUserDAO">
	
	<select id="userMidList" resultSets="String">
		select mid from user2 order by mid desc;
	</select>
	
	<select id="userGenderSearch" resultSets="com.spring.greenStudyS.vo.User2VO">
		select distinct gender from user2 order by gender;
	</select>
	
	<select id="userMidSearch" resultSets="com.spring.greenStudyS.vo.User2VO">
		select * from user2 where mid = #{mid};
	</select>
	
	<select id="userGenderList" resultSets="com.spring.greenStudyS.vo.User2VO">
		select * from user2 where gender = #{gender};
	</select>
	
	<select id="midExactCheck" resultSets="com.spring.greenStudyS.vo.User2VO">
		select * from user2 where mid like #{mid};
	</select>
	
	<select id="midPartCheck" resultSets="com.spring.greenStudyS.vo.User2VO">
		select * from user2 where mid like concat('%',#{mid},'%') order by idx asc;
		<!-- select * from user where mid like concat('%',#{mid},'%') order by idx desc; -->
	</select>
	
	<select id="getEmailList" resultType="com.spring.greenStudyS.vo.MemberVO">
		select mid, nickName, name, email from member;
	</select>
	
</mapper>