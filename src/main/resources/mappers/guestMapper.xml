<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- <mapper namespace="user2NS"> -->
<mapper namespace="com.spring.greenStudyS.dao.GuestDAO">

	<select id="getGuestList" resultSets="com.spring.greenStudyS.vo.GuestVO">
		select * from guest order by idx desc limit #{startIndexNo}, #{pageSize} ;
	</select>
	
	<select id="getTotRecCnt" resultType="int">
		select count(*) from guest;
	</select>
	
	<select id="setGuestUpdate" resultSets="com.spring.greenStudyS.vo.GuestVO">
		select * from guest where idx = #{idx};
	</select>
		
	<insert id="guestInput">
		insert into guest values(default, #{vo.name}, #{vo.content}, #{vo.email}, #{vo.homePage}, #{vo.hostIp}, default);
	</insert>
	
	<delete id="setGuestDelete">
		delete from guest where idx = #{idx};
	</delete>
	<update id="setGuestUpdateOK">
		update guest set name = #{vo.name}, content = #{vo.content}, email = #{vo.email} , homePage = #{vo.homePage} , hostIp = #{vo.hostIp} where idx = #{idx};
	</update>
	
</mapper>